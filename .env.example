RG_ENV=development
RG_SESSION_SECRET=replace-with-a-long-random-secret
RG_DATABASE_URL=sqlite:///data/royal_guardian.db
RG_PUBLIC_BASE_URL=http://127.0.0.1:8000
RG_ALLOW_REGISTRATION=true

# AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Billing / communications
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Stripe plan Price IDs (create recurring prices in Stripe Dashboard)
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_IT_DEVICE=

# Signed endpoint updates (base64 Ed25519 public key; private key stays in CI/release vault)
RG_UPDATE_PUBLIC_KEY_B64=

# Separate secret used for encrypted OAuth/MFA material (must differ from session secret in production)
RG_ENCRYPTION_SECRET=replace-with-a-different-long-random-secret

# Transactional email (SMTP; use your provider credentials)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
